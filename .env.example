# Core Django settings
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key

# The application reads DJANGO_DEBUG.
DJANGO_DEBUG=True

# Use config.settings for local development and config.settings_production for real deployments.
DJANGO_SETTINGS_MODULE=config.settings

# Local hosts
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Database
# Development SQLite example:
DATABASE_URL=sqlite:///db.sqlite3

# Containerized PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/tizahab_db

# Optional local/dev-only demo data import at container startup
DJANGO_LOAD_DEMO_DATA=False

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_BROWSER_MAPS_API_KEY=your-google-maps-browser-api-key

# Email
# Local/dev can keep the default console backend from config.settings
# Production should use config.settings_production and real SMTP credentials
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@example.com
