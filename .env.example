# Core Django settings
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key

# The application currently reads DJANGO_DEBUG.
# DEBUG is included as a convenience alias for documentation and local workflows.
DEBUG=True
DJANGO_DEBUG=True

# Local hosts
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Development SQLite example:
DATABASE_URL=sqlite:///db.sqlite3

# Containerized PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/tizahab_db

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Email
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
